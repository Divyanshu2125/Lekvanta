# Environment variables for Lekvanta Backend

# Server
PORT=4000
NODE_ENV=development

# Database — Neon PostgreSQL Cloud Database
# Example Neon pooled connection string with SSL enabled:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS - frontend origin
FRONTEND_URL=http://localhost:5173

# Descope Authentication
DESCOPE_PROJECT_ID=P3MHZdzcXDlJn2gOSo59IpPaIGJn
