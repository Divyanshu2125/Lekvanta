{
  "name": "lekvanta",
  "version": "1.0.0",
  "description": "Lekvanta - SME Business Management Suite",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm --prefix backend run start",
    "db:seed": "npm --prefix backend run db:seed",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:push": "npm --prefix backend run db:push",
    "db:studio": "npm --prefix backend run db:studio",
    "electron:start": "electron .",
    "electron:dev": "concurrently -n \"backend,frontend,electron\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.7.0",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.lekvanta.desktop",
    "productName": "Lekvanta",
    "copyright": "Copyright 2024 Lekvanta",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.map"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/prisma",
        "to": "backend/prisma",
        "filter": [
          "schema.prisma",
          "lekvanta.db",
          "migrations/**/*"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/favicon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lekvanta",
      "installerIcon": "frontend/public/favicon.ico",
      "uninstallerIcon": "frontend/public/favicon.ico",
      "deleteAppDataOnUninstall": false
    },
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/**/*.node",
      "**/backend/node_modules/.prisma/**"
    ]
  }
}
